[Unit]
Description=HisseChat Media Transcode Worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/paralaus-project
Environment=NODE_ENV=production
EnvironmentFile=-/root/paralaus-project/.env
ExecStart=/usr/bin/npm run start:media-worker
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=media-worker

[Install]
WantedBy=multi-user.target
